frr version 8.5
frr defaults traditional
hostname R3
log syslog informational
no ipv6 forwarding
!
ip route {{ ebgp_peer_ip }}/32 10.0.2.1
!
router bgp {{ bgp_as }}
 bgp router-id {{ bgp_router_id }}
 no bgp ebgp-requires-policy
 neighbor {{ ebgp_peer_ip }} remote-as 100
 neighbor {{ ebgp_peer_ip }} description R1-eBGP-peer
 !
 address-family ipv4 unicast
  network {{ advertised_prefix }}
  neighbor {{ ebgp_peer_ip }} activate
 exit-address-family
!
line vty
!
